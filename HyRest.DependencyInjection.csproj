<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Ternary-teal.ico</ApplicationIcon>
    <PackageIcon>Ternary-teal.png</PackageIcon>
    <VersionPrefix>10.0.9</VersionPrefix>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Ternary-teal.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\resources\Ternary-teal.png">
