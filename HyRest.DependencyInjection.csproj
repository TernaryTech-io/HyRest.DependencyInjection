    <PackageReference Include="Microsoft.Extensions.Diagnostics" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HyRest\HyRest.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="HyRest" />
    <Using Include="HyRest.OnBase" />
    <Using Include="HyRest.OnBase.Administration" />
    <Using Include="HyRest.OnBase.Core" />
    <Using Include="HyRest.OnBase.Session" />
    <Using Include="HyRest.OnBase.WorkView" />
